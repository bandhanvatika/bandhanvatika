// =============================================================================
// Bandhan Vatika - Quotation Management Module Prisma Schema
// Models: Quotation, QuotationItem
// Enum: QuotationStatus (DRAFT, SENT, ACCEPTED, REJECTED, CONVERTED)
// Relations: Customer (Required), Booking (Optional), QuotationItem (One-to-Many)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

/// Explicit lifecycle state machine for event price proposals
enum QuotationStatus {
  DRAFT      // Initial proposal creation, editable
  SENT       // Formally delivered to customer, locked from inline editing
  ACCEPTED   // Approved by customer, eligible for booking conversion
  REJECTED   // Declined by customer with recorded reason
  CONVERTED  // Successfully converted to confirmed event booking contract
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

/// Formal Price Proposals & Venue Quotations
model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique // e.g. "BV-QUO-2026-00001"
  
  // Mandatory Customer Relation
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  // Optional Booking Relation (populated upon conversion or quote-for-booking)
  bookingId       String?
  booking         Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  
  // Optional Hall / Venue Reference
  hallId          String?
  hall            Hall?           @relation(fields: [hallId], references: [id], onDelete: SetNull)

  // Event Specifications
  eventType       String          // e.g. Wedding, Reception, Sangeet, Corporate Gala
  eventDate       String          // Event execution date (YYYY-MM-DD)
  
  // Itemized Services & Venue Line Items (One-to-Many Relation)
  items           QuotationItem[]

  // Precision Financial Breakdown (Decimal 12, 2)
  subtotal        Decimal         @default(0.00) @db.Decimal(12, 2)
  discount        Decimal         @default(0.00) @db.Decimal(12, 2)
  taxPercent      Decimal         @default(18.00) @db.Decimal(5, 2)
  taxAmount       Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0.00) @db.Decimal(12, 2)

  // Validity, Terms & Notes
  validUntil      String          // Proposal expiration date (YYYY-MM-DD)
  terms           String?         @db.Text
  notes           String?         @db.Text

  // Lifecycle State Machine
  status          QuotationStatus @default(DRAFT)

  // Audit Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([quotationNumber])
  @@index([customerId])
  @@index([bookingId])
  @@index([hallId])
  @@index([status])
  @@index([eventDate])
}

/// Itemized services, venue hire, and equipment line items
model QuotationItem {
  id          String    @id @default(cuid())
  
  // Foreign Key to parent Quotation
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  // Item Specifications
  description String    // e.g. "Grand Vatika Royal Lawn Tariff", "Mandap Floral Setup"
  quantity    Int       @default(1)
  rate        Decimal   @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(12, 2) // Computed as (quantity * rate)
  notes       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quotationId])
}

// -----------------------------------------------------------------------------
// REFERENCED ENTITY STUBS (For standalone compilation reference)
// -----------------------------------------------------------------------------

model Customer {
  id           String      @id @default(cuid())
  customerCode String      @unique
  name         String
  mobile       String      @unique
  email        String?
  isActive     Boolean     @default(true)
  quotations   Quotation[]
  bookings     Booking[]
}

model Booking {
  id            String      @id @default(cuid())
  bookingNumber String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotations    Quotation[]
}

model Hall {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  quotations Quotation[]
}
